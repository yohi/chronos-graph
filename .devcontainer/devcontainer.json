{
  "name": "ChronosGraph Dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/chronos-graph",
  "runServices": ["postgres", "neo4j", "redis"],
  "overrideCommand": true,
  "shutdownAction": "stopCompose",
  "postCreateCommand": "bash .devcontainer/setup.sh && /home/vscode/.venv/bin/pre-commit install --hook-type pre-push",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.linting.enabled": true,
        "python.linting.ruffEnabled": true,
        "python.linting.ruffPath": "/usr/local/bin/ruff",
        "python.linting.mypyEnabled": true,
        "python.linting.mypyPath": "/usr/local/bin/mypy",
        "python.formatting.provider": "ruff",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
          }
        },
        "ruff.lint.args": ["--config=pyproject.toml"],
        "ruff.format.args": ["--config=pyproject.toml"],
        "mypy.configFile": "pyproject.toml",
        "files.trimTrailingWhitespace": true
      },
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.vscode-pylance",
        "mutantdino.resolution-status",
        "editorconfig.editorconfig",
        "njpwerner.autodocstring"
      ],
      "tasks": {
        "version": "2.0.0",
        "tasks": [
          {
            "label": "Install Dependencies",
            "type": "shell",
            "command": "uv sync --frozen --all-extras",
            "problemMatcher": [],
            "presentation": {
              "clear": true,
              "panel": "shared"
            }
          },
          {
            "label": "Prisma Generate",
            "type": "shell",
            "command": "uv run prisma generate --schema=./prisma/schema.prisma",
            "problemMatcher": [],
            "presentation": {
              "reveal": "always",
              "panel": "shared"
            },
            "dependsOn": [
              "Install Dependencies"
            ]
          },
          {
            "label": "Run Tests",
            "type": "shell",
            "command": "pytest tests/ -v",
            "problemMatcher": [
              "$pytest"
            ],
            "presentation": {
              "reveal": "always",
              "panel": "shared"
            },
            "dependsOn": [
              "Install Dependencies"
            ],
            "group": {
              "kind": "test",
              "isDefault": true
            }
          },
          {
            "label": "Run Unit Tests Only",
            "type": "shell",
            "command": "pytest tests/unit -v --cov=src/context_store",
            "problemMatcher": [
              "$pytest"
            ],
            "presentation": {
              "reveal": "always",
              "panel": "shared"
            },
            "dependsOn": [
              "Install Dependencies"
            ],
            "group": "test"
          },
          {
            "label": "Run Ruff Check",
            "type": "shell",
            "command": "ruff check src/ tests/",
            "problemMatcher": [
              "$rustc"
            ],
            "presentation": {
              "reveal": "always",
              "panel": "shared"
            },
            "dependsOn": [
              "Install Dependencies"
            ],
            "group": "lint"
          },
          {
            "label": "Run Ruff Format",
            "type": "shell",
            "command": "ruff format src/ tests/",
            "problemMatcher": [
              "$rustc"
            ],
            "presentation": {
              "reveal": "always",
              "panel": "shared"
            },
            "dependsOn": [
              "Install Dependencies"
            ],
            "group": "lint"
          },
          {
            "label": "Run MyPy",
            "type": "shell",
            "command": "mypy src/",
            "problemMatcher": [
              "$mypy"
            ],
            "presentation": {
              "reveal": "always",
              "panel": "shared"
            },
            "dependsOn": [
              "Install Dependencies"
            ],
            "group": "lint"
          },
          {
            "label": "Run Full Lint",
            "type": "shell",
            "command": "ruff check src/ tests/ && ruff format --check src/ tests/ && mypy src/",
            "problemMatcher": [
              "$rustc",
              "$mypy"
            ],
            "presentation": {
              "reveal": "always",
              "panel": "shared"
            },
            "dependsOn": [
              "Install Dependencies"
            ],
            "group": "lint"
          },
          {
            "label": "Run All Checks (CI)",
            "type": "shell",
            "command": "ruff check src/ tests/ && ruff format --check src/ tests/ && mypy src/ && pytest tests/unit -v --cov=src/context_store",
            "problemMatcher": [
              "$rustc",
              "$mypy",
              "$pytest"
            ],
            "presentation": {
              "reveal": "always",
              "panel": "shared"
            },
            "dependsOn": [
              "Install Dependencies"
            ]
          },
          {
            "label": "Start Infrastructure (Docker Compose)",
            "type": "shell",
            "command": "docker compose up -d",
            "problemMatcher": [],
            "presentation": {
              "reveal": "always",
              "panel": "dedicated",
              "close": false
            },
            "runOptions": {
              "instance": "local"
            }
          },
          {
            "label": "Stop Infrastructure",
            "type": "shell",
            "command": "docker compose down",
            "problemMatcher": [],
            "presentation": {
              "reveal": "always",
              "panel": "dedicated"
            },
            "runOptions": {
              "instance": "local"
            }
          }
        ]
      }
    }
  },
  "remoteEnv": {
    "POSTGRES_HOST": "postgres",
    "POSTGRES_PORT": "5432",
    "NEO4J_URI": "bolt://neo4j:7687",
    "REDIS_URL": "redis://redis:6379",
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv"
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "PYTHONUNBUFFERED": "1",
    "PYTHONDONTWRITEBYTECODE": "1",
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv"
  }
}
