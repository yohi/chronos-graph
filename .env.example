# ChronosGraph Environment Variables Reference (.env.example)
# This file contains all environment variables supported by context-store-mcp and mcp-gateway.

# ==============================================================================
# 1. CORE CONFIGURATION
# ==============================================================================
# storage_backend: sqlite | postgres | supabase
STORAGE_BACKEND=sqlite

# graph_enabled: Enable graph relationship features (Neo4j for postgres, recursive CTE for sqlite)
GRAPH_ENABLED=false

# cache_backend: inmemory | redis
CACHE_BACKEND=inmemory

# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ==============================================================================
# 2. SQLITE STORAGE (storage_backend=sqlite)
# ==============================================================================
# Path to the SQLite database file.
SQLITE_DB_PATH=~/.context-store/memories.db

# Multi-process concurrency control
STALE_LOCK_TIMEOUT_SECONDS=600
SQLITE_MAX_CONCURRENT_CONNECTIONS=5
SQLITE_MAX_QUEUED_REQUESTS=20
SQLITE_ACQUIRE_TIMEOUT=2.0

# WAL (Write-Ahead Logging) management
WAL_TRUNCATE_SIZE_BYTES=104857600
WAL_PASSIVE_FAIL_CONSECUTIVE_THRESHOLD=3
WAL_PASSIVE_FAIL_WINDOW_SECONDS=600
WAL_PASSIVE_FAIL_WINDOW_COUNT_THRESHOLD=5

# Cache coherence polling interval (seconds) for multi-process in-memory cache
CACHE_COHERENCE_POLL_INTERVAL_SECONDS=5.0
FORCE_CACHE_COHERENCE_IN_READ_ONLY=false

# ==============================================================================
# 3. POSTGRESQL STORAGE (storage_backend=postgres)
# ==============================================================================
#POSTGRES_HOST=localhost
#POSTGRES_PORT=5435
#POSTGRES_DB=context_store
#POSTGRES_USER=context_store
#POSTGRES_PASSWORD=your-password
#POSTGRES_SSL=false
#POSTGRES_SSL_NO_VERIFY=false
#POSTGRES_STATEMENT_CACHE_SIZE=256

# ==============================================================================
# 4. SUPABASE STORAGE (storage_backend=supabase)
# ==============================================================================
# Supabase Data API (PostgREST) access
#SUPABASE_URL=https://your-project.supabase.co
#SUPABASE_KEY=your-service-role-key
#SUPABASE_REQUEST_TIMEOUT_SECONDS=10.0

# ==============================================================================
# 5. NEO4J GRAPH RELATIONSHIPS (graph_enabled=true and storage_backend=postgres)
# ==============================================================================
#NEO4J_URI=bolt://localhost:7687
#NEO4J_USER=neo4j
#NEO4J_PASSWORD=your-password

# ==============================================================================
# 6. REDIS CACHE (cache_backend=redis)
# ==============================================================================
#REDIS_URL=redis://localhost:6379
#REDIS_SSL=false
#REDIS_SOCKET_CONNECT_TIMEOUT=5.0
#REDIS_SOCKET_TIMEOUT=5.0

# ==============================================================================
# 7. GRAPH SYNC OUTBOX (rev.11 Transactional Outbox)
# ==============================================================================
# sync: GraphLinker が Neo4j に直接同期書き込み (デフォルト)
# async_outbox: Storage TX 内で Outbox に書き込み、Worker が非同期で Neo4j 同期
GRAPH_SYNC_MODE=sync
#OUTBOX_POLL_INTERVAL_SECONDS=5.0
#OUTBOX_BATCH_SIZE=100
#OUTBOX_MAX_RETRIES=10
#OUTBOX_BACKOFF_BASE_SECONDS=1.0
#OUTBOX_BACKOFF_MAX_SECONDS=60.0

# ==============================================================================
# 8. EMBEDDING PROVIDER
# ==============================================================================
# embedding_provider: openai | local-model | litellm | custom-api
EMBEDDING_PROVIDER=local-model

# Vector Dimension (must match storage schema, e.g. 768 for ruri, 1536 for OpenAI)
EMBEDDING_DIMENSION=768

# Retry Policy
EMBEDDING_MAX_RETRIES=3
EMBEDDING_MIN_WAIT=1.0
EMBEDDING_MAX_WAIT=10.0
EMBEDDING_PER_ATTEMPT_TIMEOUT=10.0

# --- OpenAI Specific (embedding_provider=openai) ---
#OPENAI_API_KEY=sk-...
#OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Local Model Specific (embedding_provider=local-model) ---
LOCAL_MODEL_NAME=cl-nagoya/ruri-v3-310m

# --- LiteLLM Specific (embedding_provider=litellm) ---
#LITELLM_API_BASE=http://localhost:4000
#LITELLM_MODEL=openai/text-embedding-3-small

# --- Custom API Specific (embedding_provider=custom-api) ---
#CUSTOM_API_ENDPOINT=
#CUSTOM_API_MODEL_NAME=custom-model

# ==============================================================================
# 9. SEARCH & RETRIEVAL
# ==============================================================================
DEFAULT_TOP_K=10
SIMILARITY_THRESHOLD=0.70
DEDUP_THRESHOLD=0.90

# Graph search parameters
GRAPH_FANOUT_LIMIT=50
GRAPH_MAX_LOGICAL_DEPTH=5
GRAPH_MAX_PHYSICAL_HOPS=50
GRAPH_TRAVERSAL_TIMEOUT_SECONDS=2.0

# ==============================================================================
# 10. LIFECYCLE & MAINTENANCE
# ==============================================================================
# Time decay half-life (days)
DECAY_HALF_LIFE_DAYS=30

# Score threshold for archiving
ARCHIVE_THRESHOLD=0.05

# Similarity threshold for memory consolidation (0.85-0.89)
CONSOLIDATION_THRESHOLD=0.85

# Retention period after archiving (days)
PURGE_RETENTION_DAYS=90

# Lazy-cleanup triggers
CLEANUP_SAVE_COUNT_THRESHOLD=50
CLEANUP_INTERVAL_HOURS=24

# ==============================================================================
# 11. INGESTION & CONVERSATION ANALYSIS
# ==============================================================================
# CHRONOS_INGESTION_MODE: selective | all
CHRONOS_INGESTION_MODE=selective

# Chunking logic
CONVERSATION_CHUNK_SIZE=5
MAX_TOKENS_PER_CHUNK=1000
MAX_TURNS_PER_CHUNK=3
CHARS_PER_TOKEN=3

# Parallel ingestion processing
CHUNK_PARALLEL_SEMAPHORE_SIZE=10

# Batch processing
BATCH_MAX_CONCURRENT_JOBS=3
BATCH_CANCEL_TIMEOUT=5.0
SESSION_FLUSH_MAX_LOG_LENGTH=200000

# ==============================================================================
# 12. DASHBOARD (API Server)
# ==============================================================================
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# TrustedHostMiddleware / CORSMiddleware (comma-separated lists)
DASHBOARD_ALLOWED_HOSTS=localhost,127.0.0.1
DASHBOARD_CORS_ORIGINS=http://localhost:5173

# ==============================================================================
# 13. URL FETCH (SSRF Protection)
# ==============================================================================
ALLOW_PRIVATE_URLS=false
URL_FETCH_CONCURRENCY=3
URL_MAX_REDIRECTS=3
URL_MAX_RESPONSE_BYTES=10485760
URL_TIMEOUT_SECONDS=30
URL_ALLOWED_CONTENT_TYPES=text/*,application/json

# ==============================================================================
# 14. MCP GATEWAY (Proxy & Security)
# ==============================================================================
#MCP_GATEWAY_HOST=127.0.0.1
#MCP_GATEWAY_PORT=9100
#MCP_GATEWAY_SESSION_TTL_SECONDS=900
#MCP_GATEWAY_SESSION_IDLE_TIMEOUT_SECONDS=300
#MCP_GATEWAY_SESSION_ISSUER=chronos-mcp-gateway
#MCP_GATEWAY_POLICY_PATH=./intents.yaml
#MCP_GATEWAY_UPSTREAM_COMMAND=python,-m,context_store
#MCP_GATEWAY_UPSTREAM_ENV_PASSTHROUGH=OPENAI_API_KEY,SQLITE_DB_PATH,GRAPH_ENABLED,EMBEDDING_PROVIDER,CHRONOS_INGESTION_MODE
#MCP_GATEWAY_AUDIT_LOG_LEVEL=INFO
#MCP_GATEWAY_APPROVAL_BLOCKING_MODE=false
#MCP_GATEWAY_APPROVAL_TIMEOUT_SECONDS=30.0
#MCP_GATEWAY_APPROVAL_MAX_PENDING=1000
#MCP_GATEWAY_MAX_REQUEST_BODY_SIZE_BYTES=10485760
#MCP_GATEWAY_TOOL_TIMEOUT_SECONDS=30.0
#MCP_GATEWAY_MAX_TOOL_TIMEOUT_SECONDS=300.0

# Authentication: JSON mapping of {"agent_id": "api_key"}
#MCP_GATEWAY_API_KEYS_JSON={"default": "your-secret-key"}

# ==============================================================================
# 15. CONTEXT STORE HOOK (agent_turn_hook.py)
# ==============================================================================
# Configuration for the turn-end ingestion hook script
#MCP_GATEWAY_URL=http://127.0.0.1:9100
#MCP_GATEWAY_API_KEY=
#MCP_INTENT=memory.ingest
#MCP_HOOK_TIMEOUT_SECONDS=2.0
#MCP_HOOK_SSE_TIMEOUT_SECONDS=1.0
#MCP_HOOK_MAX_LOG_BYTES=8388608

# ==============================================================================
# 16. UNIVERSAL EVALUATOR (LLM Decision Engine)
# ==============================================================================
#CHRONOS_EVALUATOR_API_KEY=
#CHRONOS_EVALUATOR_MODEL=anthropic/claude-haiku-4-5-20251001
#CHRONOS_EVALUATOR_API_ACCOUNT_ID=
#CHRONOS_EVALUATOR_MAX_TOKENS=1536
#CHRONOS_EVALUATOR_TIMEOUT_SECONDS=10.0
#CHRONOS_EVALUATOR_FALLBACK=allow
#CHRONOS_EVALUATOR_POLICY_PATH=./intents.yaml
#CHRONOS_EVALUATOR_DEFAULT_INTENT=default
#CHRONOS_EVALUATOR_DEFAULT_AGENT_ID=claude-code
#CHRONOS_EVALUATOR_LOG_LEVEL=WARNING

# Memory Retrieval from Dashboard
#CHRONOS_DASHBOARD_URL=
#CHRONOS_DASHBOARD_API_KEY=
#CHRONOS_DASHBOARD_TIMEOUT_SECONDS=3.0
#CHRONOS_DASHBOARD_TOP_K=5
#CHRONOS_DASHBOARD_ALLOWED_HOSTS=localhost,127.0.0.1
